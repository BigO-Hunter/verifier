/- Begin source module OAI.Combinatorics.GotsmanLinial.BlockVanishing (OAI/Combinatorics/GotsmanLinial/BlockVanishing.lean). -/
namespace OAI

/-!
# Vanishing of low antidiagonal blocks

The geometric step is reduced to an explicit finite sum: multiplication on
both sides by the square root of a positive weight turns the weighted pairing
into a Fourier pairing against the signed weight.
-/

noncomputable section

open scoped BigOperators ComplexConjugate

namespace LeanBlast.GotsmanLinial

/-- The threshold convention at zero is compatible with the signed absolute
value identity used to build the weighted grading. -/
theorem abs_mul_thresholdSign (t : ℝ) : |t| * thresholdSign t = t := by
  by_cases ht : 0 ≤ t
  · simp [thresholdSign, ht, abs_of_nonneg ht]
  · simp [thresholdSign, ht, abs_of_neg (lt_of_not_ge ht)]

/-- If the image of one subspace under an operator is orthogonal to a second
subspace, the corresponding projection block vanishes. -/
theorem projectionBlock_eq_zero_of_pairing
    {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
    (U V : Submodule 𝕜 E) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection]
    (H : E →L[𝕜] E)
    (hpair : ∀ u ∈ U, ∀ v ∈ V, inner 𝕜 v (H u) = 0) :
    V.starProjection * H * U.starProjection = 0 := by
  ext x
  change V.starProjection (H (U.starProjection x)) = 0
  apply (Submodule.starProjection_apply_eq_zero_iff V).mpr
  intro v hv
  exact hpair _ (U.starProjection_apply_mem x) v hv

/-- Lift an orthogonality calculation on preimages through a common linear map
to a zero block between subspaces of its images. -/
theorem projectionBlock_eq_zero_of_map_pairing
    {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
    (A B U V : Submodule 𝕜 E) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection]
    (D : E →ₗ[𝕜] E) (H : E →L[𝕜] E)
    (hU : U ≤ A.map D) (hV : V ≤ B.map D)
    (hpair : ∀ a ∈ A, ∀ b ∈ B, inner 𝕜 (D b) (H (D a)) = 0) :
    V.starProjection * H * U.starProjection = 0 := by
  apply projectionBlock_eq_zero_of_pairing U V H
  intro u hu v hv
  obtain ⟨a, ha, rfl⟩ := hU hu
  obtain ⟨b, hb, rfl⟩ := hV hv
  exact hpair a ha b hb

/-- The finite pairing identity underlying the low antidiagonal cutoff.
The norm and inner product are the counting Euclidean ones. -/
theorem sqrtWeight_inner_eq_sum
    {Ω : Type*} [Fintype Ω]
    (w h : Ω → ℝ) (hw : ∀ x, 0 ≤ w x)
    (D : EuclideanSpace ℂ Ω →ₗ[ℂ] EuclideanSpace ℂ Ω)
    (hD : ∀ a x, D a x = (Real.sqrt (w x) : ℂ) * a x)
    (H : EuclideanSpace ℂ Ω →L[ℂ] EuclideanSpace ℂ Ω)
    (hH : ∀ a x, H a x = (h x : ℂ) * a x)
    (a b : EuclideanSpace ℂ Ω) :
    inner ℂ (D b) (H (D a)) =
      ∑ x, star (b x) * a x * ((w x : ℂ) * (h x : ℂ)) := by
  rw [PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro x _
  rw [RCLike.inner_apply', hH, hD, hD]
  calc
    star ((Real.sqrt (w x) : ℂ) * b x) *
        ((h x : ℂ) * ((Real.sqrt (w x) : ℂ) * a x)) =
      star (b x) * a x *
        (((Real.sqrt (w x) : ℂ) * (Real.sqrt (w x) : ℂ)) * (h x : ℂ)) := by
          simp only [star_mul, Complex.star_def, Complex.conj_ofReal]
          ring
    _ = star (b x) * a x * ((w x : ℂ) * (h x : ℂ)) := by
      rw [← Complex.ofReal_mul, Real.mul_self_sqrt (hw x)]

/-- Replace the weight times the diagonal sign by the actual signed weight. -/
theorem sqrtWeight_inner_eq_sum_signedWeight
    {Ω : Type*} [Fintype Ω]
    (w h : Ω → ℝ) (q : Ω → ℂ) (hw : ∀ x, 0 ≤ w x)
    (hwq : ∀ x, (w x : ℂ) * (h x : ℂ) = q x)
    (D : EuclideanSpace ℂ Ω →ₗ[ℂ] EuclideanSpace ℂ Ω)
    (hD : ∀ a x, D a x = (Real.sqrt (w x) : ℂ) * a x)
    (H : EuclideanSpace ℂ Ω →L[ℂ] EuclideanSpace ℂ Ω)
    (hH : ∀ a x, H a x = (h x : ℂ) * a x)
    (a b : EuclideanSpace ℂ Ω) :
    inner ℂ (D b) (H (D a)) = ∑ x, star (b x) * a x * q x := by
  rw [sqrtWeight_inner_eq_sum w h hw D hD H hH]
  simp only [hwq]

/-- High Fourier support of the signed weight kills every pairing whose two
unweighted degrees have smaller total degree. -/
theorem sqrtWeight_pairing_eq_zero_of_fourier_separation
    {n r s k : ℕ} (w h : Cube n → ℝ) (q : Cube n → ℂ)
    (hw : ∀ x, 0 ≤ w x) (hwq : ∀ x, (w x : ℂ) * (h x : ℂ) = q x)
    (D : EuclideanSpace ℂ (Cube n) →ₗ[ℂ] EuclideanSpace ℂ (Cube n))
    (hD : ∀ a x, D a x = (Real.sqrt (w x) : ℂ) * a x)
    (H : EuclideanSpace ℂ (Cube n) →L[ℂ] EuclideanSpace ℂ (Cube n))
    (hH : ∀ a x, H a x = (h x : ℂ) * a x)
    (a b : EuclideanSpace ℂ (Cube n))
    (ha : WithLp.ofLp a ∈ fourierSpace n r)
    (hb : WithLp.ofLp b ∈ fourierSpace n s)
    (hq : q ∈ fourierSpaceFrom n k) (hrs : r + s < k) :
    inner ℂ (D b) (H (D a)) = 0 := by
  rw [sqrtWeight_inner_eq_sum_signedWeight w h q hw hwq D hD H hH]
  exact sum_mul_eq_zero_of_fourier_separated (fourierSpace_conj_mul ha hb) hq hrs

/-- The choices `w = |p|` and `h = parity * sign(p)` multiply to the
high-degree signed polynomial, including at a zero of the polynomial. -/
theorem polynomial_signedWeight {n : ℕ} (p : MvPolynomial (Fin n) ℝ) (x : Cube n) :
    ((|polynomialValue p x| : ℝ) : ℂ) *
        ((fullParity x * thresholdSign (polynomialValue p x) : ℝ) : ℂ) =
      walshChar Finset.univ x * (polynomialValue p x : ℂ) := by
  rw [Complex.ofReal_mul]
  calc
    ((|polynomialValue p x| : ℝ) : ℂ) *
        ((fullParity x : ℂ) * (thresholdSign (polynomialValue p x) : ℂ)) =
      (fullParity x : ℂ) *
        (((|polynomialValue p x| : ℝ) : ℂ) *
          (thresholdSign (polynomialValue p x) : ℂ)) := by ring
    _ = walshChar Finset.univ x * (polynomialValue p x : ℂ) := by
      rw [← Complex.ofReal_mul, abs_mul_thresholdSign]
      simp only [fullParity, walshChar, Complex.ofReal_prod]

/-- The weighted pairing vanishes for the polynomial, weight,
and parity-modified threshold sign.  No Fourier-support assumption remains. -/
theorem polynomial_sqrtWeight_pairing_eq_zero
    {n d r s : ℕ} (p : MvPolynomial (Fin n) ℝ)
    (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x, polynomialValue p x ≠ 0)
    (a b : EuclideanSpace ℂ (Cube n))
    (ha : WithLp.ofLp a ∈ fourierSpace n r)
    (hb : WithLp.ofLp b ∈ fourierSpace n s) (hrs : r + s < n - d) :
    let D := sqrtWeightEquiv (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x))
    inner ℂ (D b)
      (signMultiplier (fun x => fullParity x * thresholdSign (polynomialValue p x)) (D a))
        = 0 := by
  dsimp only
  apply sqrtWeight_pairing_eq_zero_of_fourier_separation
    (fun x => |polynomialValue p x|)
    (fun x => fullParity x * thresholdSign (polynomialValue p x))
    (fun x => walshChar Finset.univ x * (polynomialValue p x : ℂ))
    (fun x => abs_nonneg (polynomialValue p x)) (polynomial_signedWeight p)
    _ (fun a x => sqrtWeightEquiv_apply _ _ a x)
    _ (fun a x => signMultiplier_apply _ a x) a b ha hb
    (parity_polynomialValue_mem_fourierSpaceFrom hp hd) hrs

/-- The operator between two subspaces of weighted low-degree spaces is zero
below the polynomial's degree cutoff. -/
theorem polynomial_projectionBlock_eq_zero
    {n d r s : ℕ} (p : MvPolynomial (Fin n) ℝ)
    (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x, polynomialValue p x ≠ 0)
    (U V : Submodule ℂ (EuclideanSpace ℂ (Cube n)))
    (hU : U ≤ weightedFourierSpace (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x)) r)
    (hV : V ≤ weightedFourierSpace (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x)) s)
    (hrs : r + s < n - d) :
    V.starProjection *
      signMultiplier (fun x => fullParity x * thresholdSign (polynomialValue p x)) *
        U.starProjection = 0 := by
  apply projectionBlock_eq_zero_of_map_pairing
    (fourierEuclideanSpace n r) (fourierEuclideanSpace n s) U V
    (sqrtWeightEquiv (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x))).toLinearMap _ hU hV
  intro a ha b hb
  apply polynomial_sqrtWeight_pairing_eq_zero (r := r) (s := s) p hp hd hnz a b
  · simpa only [mem_fourierEuclideanSpace] using ha
  · simpa only [mem_fourierEuclideanSpace] using hb
  · exact hrs

/-- Low antidiagonal vanishing for the actual weighted grading constructed
from the polynomial.  All geometric hypotheses are discharged. -/
theorem weightedFlag_block_eq_zero_of_polynomial_degree
    {n d r s : ℕ} (p : MvPolynomial (Fin n) ℝ)
    (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x, polynomialValue p x ≠ 0) (hrs : r + s < n - d) :
    let K := weightedFourierFlag (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x))
    flagProjection K s *
      signMultiplier (fun x => fullParity x * thresholdSign (polynomialValue p x)) *
        flagProjection K r = 0 := by
  dsimp only
  apply polynomial_projectionBlock_eq_zero (r := r) (s := s) p hp hd hnz
  · simpa only [weightedFourierFlag_succ] using
      flagLayer_le_next
        (weightedFourierFlag (fun x => |polynomialValue p x|)
          (fun x => abs_pos.mpr (hnz x))) r
  · simpa only [weightedFourierFlag_succ] using
      flagLayer_le_next
        (weightedFourierFlag (fun x => |polynomialValue p x|)
          (fun x => abs_pos.mpr (hnz x))) s
  · exact hrs

/-- The same vanishing statement in any orthonormal matrix coordinates, ready
for the Hilbert-Schmidt block coupling. -/
theorem weightedFlag_matrixBlock_eq_zero_of_polynomial_degree
    {n d r s : ℕ} (p : MvPolynomial (Fin n) ℝ)
    (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x, polynomialValue p x ≠ 0) (hrs : r + s < n - d)
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : OrthonormalBasis ι ℂ (EuclideanSpace ℂ (Cube n))) :
    let K := weightedFourierFlag (fun x => |polynomialValue p x|)
      (fun x => abs_pos.mpr (hnz x))
    operatorMatrix b (flagProjection K s) *
      operatorMatrix b
        (signMultiplier (fun x => fullParity x * thresholdSign (polynomialValue p x))) *
      operatorMatrix b (flagProjection K r) = 0 := by
  have h := congrArg (operatorMatrix b)
    (weightedFlag_block_eq_zero_of_polynomial_degree p hp hd hnz hrs)
  simpa only [operatorMatrix_mul, operatorMatrix_zero] using h

/-- The concrete cutoff used by the finite block coupling: actual weighted
projection matrices, actual diagonal parity-modified polynomial threshold,
and no unproved construction assumptions. -/
theorem weightedProjectionMatrix_block_eq_zero_of_polynomial_degree
    {n d : ℕ} (p : MvPolynomial (Fin n) ℝ)
    (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x, polynomialValue p x ≠ 0)
    (r s : Fin (n + 1)) (hrs : r.val + s.val < n - d) :
    let w := fun x => |polynomialValue p x|
    let hw : ∀ x, 0 < w x := fun x => abs_pos.mpr (hnz x)
    weightedProjectionMatrix w hw s *
      signMatrix (fun x => fullParity x * polynomialThreshold p x) *
        weightedProjectionMatrix w hw r = 0 := by
  have h := weightedFlag_matrixBlock_eq_zero_of_polynomial_degree
    (r := r.val) (s := s.val) p hp hd hnz hrs (EuclideanSpace.basisFun (Cube n) ℂ)
  simpa only [weightedProjectionMatrix, flagProjectionMatrix, signMultiplier,
    operatorMatrix_toEuclideanCLM, polynomialThreshold] using h

end LeanBlast.GotsmanLinial

end

end OAI
/- End source module OAI.Combinatorics.GotsmanLinial.BlockVanishing. -/

/- Begin source module OAI.Combinatorics.GotsmanLinial.Main (OAI/Combinatorics/GotsmanLinial/Main.lean). -/
namespace OAI

/-!
# Assembly of the Gotsman--Linial average-sensitivity bound

The first lemmas are explicitly conditional assembly bridges. The final
theorems discharge their matrix and counting hypotheses using the concrete
weighted Boolean-cube grading and a sign-preserving constant perturbation.
-/

namespace LeanBlast.GotsmanLinial

open scoped BigOperators

/-- The two analytic constants combine to the constant `8` after
normalizing by the number of cube vertices. This is only a scalar bridge. -/
theorem normalized_edge_bound {N C T a : ℝ} (hN : 0 < N)
    (hedge : C ≤ 2 * T) (henergy : T ≤ 4 * a * N) :
    C / N ≤ 8 * a := by
  apply (div_le_iff₀ hN).mpr
  calc
    C ≤ 2 * T := hedge
    _ ≤ 2 * (4 * a * N) := mul_le_mul_of_nonneg_left henergy (by norm_num)
    _ = 8 * a * N := by ring

/-- Convert a counted-edge identity, edge recovery, and an anticommutator
energy estimate into the desired sensitivity inequality. The counting and energy premises are explicit. -/
theorem sensitivity_bound_of_counting_energy {n d : ℕ}
    (f : Cube n → ℝ) (C T : ℝ)
    (hcount : averageSensitivity f = C / (2 : ℝ) ^ n)
    (hedge : C ≤ 2 * T)
    (henergy : T ≤ 4 * ((d : ℝ) * Real.sqrt (n : ℝ)) * (2 : ℝ) ^ n) :
    averageSensitivity f ≤ 8 * (d : ℝ) * Real.sqrt (n : ℝ) := by
  rw [hcount]
  simpa only [mul_assoc] using
    normalized_edge_bound (pow_pos (by norm_num : (0 : ℝ) < 2) n) hedge henergy

/-- The finite-matrix bound assuming an orthogonal projection family with
binomial multiplicities, coordinate tridiagonality, and low-block vanishing. -/
theorem sensitivity_bound_of_cube_grading {n d : ℕ}
    (f : Cube n → ℝ) (hf : ∀ x, f x = 1 ∨ f x = -1)
    (P : Fin (n + 1) → Matrix (Cube n) (Cube n) ℂ)
    (hP : OrthogonalProjectionFamily P)
    (htrace : ∀ k, (Matrix.trace (P k)).re = (n.choose k.val : ℝ))
    (htri : ∀ i : Fin n, BlockTridiagonal P (coordinateSignMatrix i))
    (hvanish : ∀ r s : Fin (n + 1), r.val + s.val < n - d →
      P s * signMatrix (fun x => fullParity x * f x) * P r = 0) :
    averageSensitivity f ≤ 8 * (d : ℝ) * Real.sqrt (n : ℝ) := by
  classical
  let h : Cube n → ℝ := fun x => fullParity x * f x
  let H : Matrix (Cube n) (Cube n) ℂ := signMatrix h
  let M : Matrix (Cube n) (Cube n) ℂ := centeredGrading P
  have hh (x : Cube n) : h x = 1 ∨ h x = -1 := parity_twist_cases hf x
  have htotal : hsNormSq M = (n : ℝ) * (2 : ℝ) ^ n / 4 := by
    change hsNormSq (centeredGrading P) = _
    rw [hsNormSq_centeredGrading_trace hP]
    simp_rw [htrace]
    simpa only [mul_comm] using sum_choose_centered_sq n
  have hcoordinate (i : Fin n) :
      hsNormSq (M * coordinateSignMatrix i - coordinateSignMatrix i * M) ≤ (2 : ℝ) ^ n := by
    simpa only [M, card_cube, Nat.cast_pow, Nat.cast_ofNat] using
      hsNormSq_centeredGrading_commutator_le_card hP (coordinateSignMatrix i)
        (htri i) (coordinateSignMatrix_unitary i)
  have hdistance :
      (∑ x : Cube n, ∑ y : Cube n, (hammingDist x y : ℝ) * ‖M x y‖ ^ 2) ≤ hsNormSq M := by
    rw [htotal]
    exact distance_energy_le_of_coordinate_commutator_bound M hcoordinate
  have hcap (x y : Cube n) (hxy : x ≠ y) : ‖M x y‖ ^ 2 ≤ (1 : ℝ) / 4 := by
    apply off_diagonal_sq_norm_le_quarter_of_commutator_bound M _ x y hxy
    intro i a b
    exact sq_norm_centeredGrading_commutator_entry_le_one hP (coordinateSignMatrix i)
      (htri i) (coordinateSignMatrix_unitary i) a b
  have hedge : ((orderedConstantEdges h).card : ℝ) ≤
      2 * hsNormSq (M * H + H * M) := edge_recovery M h hh htotal hdistance hcap
  have henergy : hsNormSq (M * H + H * M) ≤
      4 * (d : ℝ) * Real.sqrt (n : ℝ) * (2 : ℝ) ^ n :=
    hsNormSq_centeredGrading_anticommutator_le_of_trace n d P hP H
      (signMatrix_conjTranspose_mul h hh) (signMatrix_mul_conjTranspose h hh) htrace hvanish
  apply sensitivity_bound_of_counting_energy f ((orderedConstantEdges h).card : ℝ)
    (hsNormSq (M * H + H * M)) (averageSensitivity_eq_parity_edges hf) hedge
  simpa only [mul_assoc] using henergy

/-- The bound for a polynomial without cube zeros. The projection
family and both block-vanishing properties are constructed from its absolute
value, rather than retained as hypotheses. -/
theorem polynomialThreshold_averageSensitivity_le_of_nonzero {n d : ℕ}
    (p : MvPolynomial (Fin n) ℝ) (hp : IsMultilinear p) (hd : p.totalDegree ≤ d)
    (hnz : ∀ x : Cube n, polynomialValue p x ≠ 0) :
    averageSensitivity (polynomialThreshold p) ≤ 8 * (d : ℝ) * Real.sqrt (n : ℝ) := by
  let w : Cube n → ℝ := fun x => |polynomialValue p x|
  have hw (x : Cube n) : 0 < w x := abs_pos.mpr (hnz x)
  apply sensitivity_bound_of_cube_grading (polynomialThreshold p)
    (fun x => thresholdSign_cases (polynomialValue p x))
    (weightedProjectionMatrix w hw)
    (weightedProjectionMatrix_family w hw)
    (weightedProjectionMatrix_trace_re w hw)
  · intro i
    exact weightedProjectionMatrix_tridiagonal w hw i
  · intro r s hrs
    exact weightedProjectionMatrix_block_eq_zero_of_polynomial_degree p hp hd hnz r s hrs

/-- Every real multilinear polynomial of degree at most `d` has average
sensitivity at most `8*d*sqrt(n)`, including cube zeros under `sign(0)=1`.
The argument in fact covers all natural `n` and `d`. -/
theorem polynomialThreshold_averageSensitivity_le {n d : ℕ}
    (p : MvPolynomial (Fin n) ℝ) (hp : IsMultilinear p) (hd : p.totalDegree ≤ d) :
    averageSensitivity (polynomialThreshold p) ≤ 8 * (d : ℝ) * Real.sqrt (n : ℝ) := by
  obtain ⟨q, hq, hqd, hqnz, hqf⟩ := exists_nonzero_polynomial_same_threshold hp hd
  rw [← hqf]
  exact polynomialThreshold_averageSensitivity_le_of_nonzero q hq hqd hqnz

/-- The average-sensitivity bound for `1 ≤ d ≤ n`, without auxiliary
construction hypotheses. -/
theorem gotsmanLinialStatement : GotsmanLinialStatement := by
  intro n d _ _ _ p hp hd
  exact polynomialThreshold_averageSensitivity_le p hp hd

end LeanBlast.GotsmanLinial

end OAI
/- End source module OAI.Combinatorics.GotsmanLinial.Main. -/

/- Begin source module AverageSensitivity.RefinedCoupling (AverageSensitivity/RefinedCoupling.lean). -/
/-! The finite one-sided refinement from Lagdive--Aglave--Damre,
`An elementary improvement ...`, Lemma 2. The proof here uses a single
pointwise majorant and cancellation of equal-marginal potential sums. -/
open scoped BigOperators
open OAI.LeanBlast.GotsmanLinial

namespace AverageSensitivity

theorem displacement_majorant (m a u v : ℝ) (ha : 0 ≤ a)
    (hstep : v-u ≤ a) :
    (u-v)^2 ≤ 4 * (couplingPotential m u - couplingPotential m v) +
      2*a*(|u-m|+|v-m|) + a^2 := by
  have hsum : 0 ≤ |u-m|+|v-m| := add_nonneg (abs_nonneg _) (abs_nonneg _)
  by_cases huv : u ≤ v
  · have h := (couplingPotential_increment_bounds m huv).2
    have hprod := mul_nonneg (sub_nonneg.mpr hstep) hsum
    have hsq := mul_nonneg (sub_nonneg.mpr hstep) (show 0 ≤ a+(v-u) by linarith)
    nlinarith
  · have hvu : v ≤ u := le_of_not_ge huv
    have h := (couplingPotential_increment_bounds m hvu).1
    have hprod := mul_nonneg ha hsum
    nlinarith [sq_nonneg a]

theorem finite_coupling_refined {Ω : Type*} [Fintype Ω]
    (w U V : Ω → ℝ) (m a : ℝ)
    (hw : ∀ i, 0 ≤ w i) (hprob : ∑ i, w i = 1)
    (hsame : ∀ φ : ℝ → ℝ, ∑ i, w i * φ (U i) = ∑ i, w i * φ (V i))
    (ha : 0 ≤ a) (hstep : ∀ i, w i ≠ 0 → V i-U i ≤ a) :
    ∑ i, w i*(U i-V i)^2 ≤ 4*a*(∑ i, w i*|U i-m|)+a^2 := by
  have hpoint : ∀ i, w i*(U i-V i)^2 ≤
      w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
        2*a*(|U i-m|+|V i-m|)+a^2) := by
    intro i
    by_cases hi : w i = 0
    · simp only [hi, zero_mul, mul_zero]
      norm_num
    · exact mul_le_mul_of_nonneg_left (displacement_majorant m a _ _ ha (hstep i hi)) (hw i)
  have h := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hpoint i)
  have hp := hsame (couplingPotential m)
  have habs := hsame (fun t => |t-m|)
  have heq : (∑ i, w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
        2*a*(|U i-m|+|V i-m|)+a^2)) =
      4*((∑ i, w i*couplingPotential m (U i))-(∑ i, w i*couplingPotential m (V i))) +
      2*a*((∑ i, w i*|U i-m|)+(∑ i, w i*|V i-m|)) + a^2*(∑ i,w i) := by
    simp only [mul_add, mul_sub, Finset.mul_sum, Finset.sum_add_distrib,
      Finset.sum_sub_distrib]
    simp only [mul_left_comm, mul_comm, mul_assoc]
  rw [heq, hp, sub_self, mul_zero, zero_add, hprob, mul_one, ← habs] at h
  nlinarith

/-- The good-step majorant: when the forward step is at most `2a/3`, the
uniform `a^2` charge is unnecessary — the `2a(|u-m|+|v-m|)` term already
covers the displacement. (The `a^2` is consumed only by the largest steps;
charging it to every pair is the slack the exported `+2d^2` carries.) -/
theorem displacement_majorant_good (m a u v : ℝ) (ha : 0 ≤ a)
    (hstep : v - u ≤ 2*a/3) :
    (u-v)^2 ≤ 4 * (couplingPotential m u - couplingPotential m v) +
      2*a*(|u-m|+|v-m|) := by
  have hsum : 0 ≤ |u-m|+|v-m| := add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hS : |v-u| ≤ |u-m|+|v-m| := by
    have h1 : |u-v| ≤ |u-m| + |m-v| := by
      have h := abs_add_le (u-m) (m-v)
      rw [show (u-m)+(m-v) = u-v from by ring] at h
      exact h
    rw [abs_sub_comm m v] at h1
    rw [show |u-v| = |v-u| from abs_sub_comm u v] at h1
    exact h1
  by_cases huv : u ≤ v
  · have hδ : (0:ℝ) ≤ v - u := by linarith
    have had : (0:ℝ) ≤ a - (v-u) := by nlinarith [hstep, ha]
    have hle2 : (0:ℝ) ≤ 2*a - 3*(v-u) := by nlinarith [hstep, ha]
    have hS' : (v-u) ≤ |u-m|+|v-m| := by
      rw [abs_of_nonneg hδ] at hS
      exact hS
    have h := (couplingPotential_increment_bounds m huv).2
    have e2 : (0:ℝ) ≤ 4*(couplingPotential m u - couplingPotential m v) +
        2*a*(|u-m|+|v-m|) + 2*(v-u)*(|u-m|+|v-m|) - (u-v)^2 := by
      nlinarith [h, hδ]
    have e4 : (v-u)*(a-(v-u)) ≤ (|u-m|+|v-m|)*(a-(v-u)) :=
      mul_le_mul_of_nonneg_right hS' had
    have e6 : (0:ℝ) ≤ (v-u)*(2*a - 3*(v-u)) := mul_nonneg hδ hle2
    nlinarith [e2, e4, e6, hδ]
  · have hvu : v ≤ u := by linarith
    have h := (couplingPotential_increment_bounds m hvu).1
    nlinarith [h, hsum, mul_nonneg ha hsum]

/-- The charged finite coupling: the `a^2` slack is charged only to the
indices whose forward step exceeds `2a/3`, instead of uniformly. On equal
marginals the potential and absolute-deviation sums still cancel completely —
only the charged mass `∑ i, (if 2a/3 < V i - U i then w i else 0)` survives. -/
theorem finite_coupling_refined_charge {Ω : Type*} [Fintype Ω] [DecidableEq Ω]
    (w U V : Ω → ℝ) (m a : ℝ)
    (hw : ∀ i, 0 ≤ w i) (hprob : ∑ i, w i = 1)
    (hsame : ∀ φ : ℝ → ℝ, ∑ i, w i * φ (U i) = ∑ i, w i * φ (V i))
    (ha : 0 ≤ a)
    (hstep : ∀ i, w i ≠ 0 → V i - U i ≤ a) :
    ∑ i, w i*(U i-V i)^2 ≤
      4*a*(∑ i, w i*|U i-m|) +
      a^2*(∑ i, if 2*a/3 < V i - U i then w i else 0) := by
  classical
  have hpoint : ∀ i, w i*(U i-V i)^2 ≤
      w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
        2*a*(|U i-m|+|V i-m|)) +
      a^2*(if 2*a/3 < V i - U i then w i else 0) := by
    intro i
    by_cases hi : w i = 0
    · simp only [hi, zero_mul]
      split_ifs <;> norm_num
    · by_cases hbad : 2*a/3 < V i - U i
      · have hstp := hstep i hi
        have h := displacement_majorant m a (U i) (V i) ha hstp
        have h2 := mul_le_mul_of_nonneg_left h (hw i)
        have hring : w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
            2*a*(|U i-m|+|V i-m|) + a^2) =
            w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
            2*a*(|U i-m|+|V i-m|)) + a^2*(w i) := by ring
        rw [hring] at h2
        rw [if_pos hbad]
        exact h2
      · have hgd : V i - U i ≤ 2*a/3 := le_of_not_gt hbad
        have h := displacement_majorant_good m a (U i) (V i) ha hgd
        rw [if_neg hbad, mul_zero, add_zero]
        exact mul_le_mul_of_nonneg_left h (hw i)
  have hsummed := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hpoint i)
  rw [Finset.sum_add_distrib] at hsummed
  have hp := hsame (couplingPotential m)
  have habs := hsame (fun t => |t-m|)
  have heq : (∑ i, w i*(4*(couplingPotential m (U i)-couplingPotential m (V i)) +
        2*a*(|U i-m|+|V i-m|))) =
      4*((∑ i, w i*couplingPotential m (U i))-(∑ i, w i*couplingPotential m (V i))) +
      2*a*((∑ i, w i*|U i-m|)+(∑ i, w i*|V i-m|)) := by
    simp only [mul_add, mul_sub, Finset.mul_sum, Finset.sum_add_distrib,
      Finset.sum_sub_distrib]
    simp only [mul_left_comm, mul_comm, mul_assoc]
  rw [heq, hp, sub_self, mul_zero, zero_add, ← Finset.mul_sum] at hsummed
  have hmid : 2*a*(∑ i, w i*|U i-m| + ∑ i, w i*|V i-m|) +
      a^2*(∑ i, if 2*a/3 < V i - U i then w i else 0) ≤
      4*a*(∑ i, w i*|U i-m|) +
      a^2*(∑ i, if 2*a/3 < V i - U i then w i else 0) := by
    rw [habs]
    linarith
  exact hsummed.trans hmid

/-- Split a weighted square sum by the sign of the forward step `D = V - U`.
Pure pointwise identity, no hypotheses. -/
theorem drift_sq_split {Ω : Type*} [Fintype Ω] (w U V : Ω → ℝ) :
    ∑ i, w i * (V i - U i)^2 =
      (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) +
      (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) := by
  classical
  have hpt : ∀ i ∈ (Finset.univ : Finset Ω), w i * (V i - U i)^2 =
      (if 0 < V i - U i then w i * (V i - U i)^2 else 0) +
      (if V i - U i < 0 then w i * (V i - U i)^2 else 0) +
      (if V i - U i = 0 then w i * (V i - U i)^2 else 0) := by
    intro i _
    rcases lt_trichotomy (V i - U i) 0 with h | h | h
    · rw [if_neg (by linarith), if_pos h, if_neg (by linarith)]
      ring
    · rw [if_neg (by linarith), if_neg (by linarith), if_pos h]
      ring
    · rw [if_pos h, if_neg (by linarith), if_neg (by linarith)]
      ring
  have hz : (∑ i, if V i - U i = 0 then w i * (V i - U i)^2 else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    by_cases h : V i - U i = 0
    · rw [if_pos h, h]
      ring
    · rw [if_neg h]
  calc ∑ i, w i * (V i - U i)^2 =
      (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) +
      (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) +
      (∑ i, if V i - U i = 0 then w i * (V i - U i)^2 else 0) := by
        rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i hi => hpt i hi)
    _ = (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) +
      (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) := by rw [hz, add_zero]

/-- On equal marginals the positive and negative parts of the drift have the
same weighted mass: `t = E D⁺ = E D⁻`. -/
theorem drift_pos_eq_neg {Ω : Type*} [Fintype Ω] (w U V : Ω → ℝ)
    (hmean : ∑ i, w i * (V i - U i) = 0) :
    (∑ i, w i * max (V i - U i) 0) =
      (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
  classical
  have hmax : ∀ i ∈ (Finset.univ : Finset Ω),
      w i * (V i - U i) + (if V i - U i < 0 then w i * (U i - V i) else 0) =
      w i * max (V i - U i) 0 := by
    intro i _
    by_cases h : V i - U i < 0
    · rw [if_pos h, max_eq_right (by linarith : V i - U i ≤ 0)]
      ring
    · rw [if_neg h, max_eq_left (by linarith : 0 ≤ V i - U i)]
      ring
  calc (∑ i, w i * max (V i - U i) 0)
      = (∑ i, w i * (V i - U i)) +
          (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i hi => (hmax i hi).symm)
    _ = (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
        rw [hmean, zero_add]

/-- Three-way split of a weighted sum by the sign of the forward step
`D = V - U`.  Pure pointwise identity, no hypotheses. -/
theorem drift_sum_split_ite {Ω : Type*} [Fintype Ω] (w U V F : Ω → ℝ) :
    ∑ i, w i * F i =
      (∑ i, if 0 < V i - U i then w i * F i else 0) +
      (∑ i, if V i - U i < 0 then w i * F i else 0) +
      (∑ i, if V i - U i = 0 then w i * F i else 0) := by
  classical
  have hpt : ∀ i ∈ (Finset.univ : Finset Ω), w i * F i =
      (if 0 < V i - U i then w i * F i else 0) +
      (if V i - U i < 0 then w i * F i else 0) +
      (if V i - U i = 0 then w i * F i else 0) := by
    intro i _
    rcases lt_trichotomy (V i - U i) 0 with h | h | h
    · rw [if_neg (by linarith), if_pos h, if_neg (by linarith)]
      ring
    · rw [if_neg (by linarith), if_neg (by linarith), if_pos h]
      ring
    · rw [if_pos h, if_neg (by linarith), if_neg (by linarith)]
      ring
  calc ∑ i, w i * F i =
      (∑ i, if 0 < V i - U i then w i * F i else 0) +
      (∑ i, if V i - U i < 0 then w i * F i else 0) +
      (∑ i, if V i - U i = 0 then w i * F i else 0) := by
        rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i hi => hpt i hi)

/-! ## The compensated coupling (Lagdive–Aglave–Damre, Lemma 2)

The at-term form `E D² + a·t ≤ 4·a·b` under a ONE-sided step `V - U ≤ a`,
via the compensation identity for the potential `couplingPotential m` and
the complement bound `E[A·1_{D>0}] ≤ 2b - t` (`A ≥ |D|` pointwise).  The
center `m` is arbitrary — the paper takes the common mean, but no property
of `m` is used.  See `compensated_coupling_at` below. -/

/-- **Lemma 2 (compensated coupling), at-term form** — Lagdive–Aglave–Damre,
`A compensated coupling bound for the average sensitivity of polynomial
threshold functions`, Lemma 2.  For equal marginals with one-sided step
`V - U ≤ a`, with `b = E|U - m|` (arbitrary center `m`; the paper centers at
the common mean, which the proof never uses) and `t = E D⁺ = E D⁻`:

  `E D² + a·t ≤ 4·a·b`.

The proof: on `D < 0` the LOWER chord bound for `couplingPotential` charges
`D²` to `4·(g U - g V)`; equal marginals give the compensation identity
`E[(g V - g U) 1_{D>0}] = E[(g U - g V) 1_{D<0}]`; on `D > 0` the UPPER
chord bound and the step give `g V - g U ≤ (a/2)·A`, and the complement
`E[A·1_{D>0}] ≤ 2b - t` follows from `A ≥ |D|` pointwise.  This strengthens
the two-sided `compensated_coupling` (CompensatedCoupling.lean) in two ways:
the step hypothesis is one-sided, and the conclusion carries the `+ a·t`
sharpening needed for the finite-range corollary.  Homogeneous in `w`: no
normalization hypothesis. -/
theorem compensated_coupling_at {Ω : Type*} [Fintype Ω]
    (w U V : Ω → ℝ) (m a : ℝ)
    (hw : ∀ i, 0 ≤ w i)
    (hsame : ∀ φ : ℝ → ℝ, ∑ i, w i * φ (U i) = ∑ i, w i * φ (V i))
    (ha : 0 ≤ a) (hstep : ∀ i, V i - U i ≤ a) :
    (∑ i, w i * (V i - U i)^2) + a * (∑ i, w i * max (V i - U i) 0) ≤
      4 * a * (∑ i, w i * |U i - m|) := by
  classical
  set b : ℝ := ∑ i, w i * |U i - m| with hbdef
  -- pointwise facts
  have hAnneg : ∀ i, 0 ≤ |U i - m| + |V i - m| := fun i =>
    add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hAsub : ∀ i, |V i - U i| ≤ |U i - m| + |V i - m| := by
    intro i
    have h1 : |V i - U i| ≤ |V i - m| + |m - U i| := by
      have h := abs_add_le (V i - m) (m - U i)
      have he : V i - m + (m - U i) = V i - U i := by ring
      rw [he] at h
      exact h
    rw [abs_sub_comm m (U i)] at h1
    linarith
  have hchordneg : ∀ i, V i - U i < 0 → (V i - U i)^2 ≤
      4 * (couplingPotential m (U i) - couplingPotential m (V i)) := by
    intro i hneg
    have hvu : V i ≤ U i := le_of_lt (sub_neg.mp hneg)
    have h := couplingPotential_increment_lower m hvu
    have he : (V i - U i)^2 = (U i - V i)^2 := by ring
    rw [he]
    nlinarith [h]
  have hchordpos : ∀ i, 0 < V i - U i →
      couplingPotential m (V i) - couplingPotential m (U i) ≤
        (V i - U i) / 2 * (|U i - m| + |V i - m|) :=
    fun i hpos => couplingPotential_increment_upper m (le_of_lt (sub_pos.mp hpos))
  -- zero-mass sums from equal marginals
  have hmean : ∑ i, w i * (V i - U i) = 0 := by
    have h1 := hsame (fun t => t)
    have hsplit : ∑ i, w i * (V i - U i) =
        (∑ i, w i * V i) - (∑ i, w i * U i) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hsplit, h1, sub_self]
  have hpot0 : ∑ i, w i *
      (couplingPotential m (V i) - couplingPotential m (U i)) = 0 := by
    have h1 := hsame (couplingPotential m)
    have hsplit : ∑ i, w i *
        (couplingPotential m (V i) - couplingPotential m (U i)) =
        (∑ i, w i * couplingPotential m (V i)) -
        (∑ i, w i * couplingPotential m (U i)) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hsplit, h1, sub_self]
  -- the compensation identity: E[(gV - gU) 1_{D>0}] = E[(gU - gV) 1_{D<0}]
  have hcomp : (∑ i, if 0 < V i - U i then
        w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) +
      (∑ i, if V i - U i < 0 then
        w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) = 0 := by
    have hgz : (∑ i, if V i - U i = 0 then
        w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      by_cases h : V i - U i = 0
      · have hvu : V i = U i := by linarith
        rw [if_pos h, hvu]
        ring
      · rw [if_neg h]
    have hgs := drift_sum_split_ite w U V
      (fun i => couplingPotential m (V i) - couplingPotential m (U i))
    rw [hgz, add_zero] at hgs
    linarith [hgs, hpot0]
  -- negative side: D² charges to 4·(gU - gV), compensated, then chorded by a/2
  have hneg : (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) ≤
      2 * a * (∑ i, if 0 < V i - U i then
        w i * (|U i - m| + |V i - m|) else 0) := by
    have s1 : (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) ≤
        (∑ i, if V i - U i < 0 then
          w i * (4 * (couplingPotential m (U i) - couplingPotential m (V i))) else 0) := by
      apply Finset.sum_le_sum
      intro i _
      by_cases h : V i - U i < 0
      · rw [if_pos h, if_pos h]
        exact mul_le_mul_of_nonneg_left (hchordneg i h) (hw i)
      · rw [if_neg h, if_neg h]
    have s2 : (∑ i, if V i - U i < 0 then
          w i * (4 * (couplingPotential m (U i) - couplingPotential m (V i))) else 0) =
        4 * (∑ i, if V i - U i < 0 then
          w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0) := by
      have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
          (if V i - U i < 0 then
            w i * (4 * (couplingPotential m (U i) - couplingPotential m (V i))) else 0) =
          4 * (if V i - U i < 0 then
            w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0) := by
        intro i _
        by_cases h : V i - U i < 0
        · rw [if_pos h, if_pos h]
          ring
        · rw [if_neg h, if_neg h]
          ring
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i hi => hpt i hi)
    have s3 : (∑ i, if V i - U i < 0 then
          w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0) =
        -(∑ i, if V i - U i < 0 then
          w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) := by
      have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
          (if V i - U i < 0 then
            w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0) =
          -((if V i - U i < 0 then
            w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0)) := by
        intro i _
        by_cases h : V i - U i < 0
        · rw [if_pos h, if_pos h]
          ring
        · rw [if_neg h, if_neg h]
          ring
      calc (∑ i, if V i - U i < 0 then
            w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0)
          = (∑ i, -((if V i - U i < 0 then
            w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0))) :=
            Finset.sum_congr rfl (fun i hi => hpt i hi)
        _ = -(∑ i, if V i - U i < 0 then
            w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) := by
            rw [Finset.sum_neg_distrib]
    have s5 : (∑ i, if 0 < V i - U i then
          w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) ≤
        (a/2) * (∑ i, if 0 < V i - U i then
          w i * (|U i - m| + |V i - m|) else 0) := by
      have h1 : (∑ i, if 0 < V i - U i then
          w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) ≤
          (∑ i, if 0 < V i - U i then
          w i * ((a/2) * (|U i - m| + |V i - m|)) else 0) := by
        apply Finset.sum_le_sum
        intro i _
        by_cases h : 0 < V i - U i
        · rw [if_pos h, if_pos h]
          exact mul_le_mul_of_nonneg_left
            (le_trans (hchordpos i h)
              (mul_le_mul_of_nonneg_right (by linarith [hstep i]) (hAnneg i))) (hw i)
        · rw [if_neg h, if_neg h]
      have h2 : (∑ i, if 0 < V i - U i then
          w i * ((a/2) * (|U i - m| + |V i - m|)) else 0) =
          (a/2) * (∑ i, if 0 < V i - U i then
          w i * (|U i - m| + |V i - m|) else 0) := by
        have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
            (if 0 < V i - U i then
              w i * ((a/2) * (|U i - m| + |V i - m|)) else 0) =
            (a/2) * (if 0 < V i - U i then
              w i * (|U i - m| + |V i - m|) else 0) := by
          intro i _
          by_cases h : 0 < V i - U i
          · rw [if_pos h, if_pos h]
            ring
          · rw [if_neg h, if_neg h]
            ring
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i hi => hpt i hi)
      rw [h2] at h1
      exact h1
    have c3 : -(∑ i, if V i - U i < 0 then
        w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) =
        (∑ i, if 0 < V i - U i then
        w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) := by
      linarith [hcomp]
    calc (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) ≤
          4 * (∑ i, if V i - U i < 0 then
          w i * (couplingPotential m (U i) - couplingPotential m (V i)) else 0) := by
            rw [← s2]; exact s1
      _ = 4 * -(∑ i, if V i - U i < 0 then
          w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) := by rw [s3]
      _ = 4 * (∑ i, if 0 < V i - U i then
          w i * (couplingPotential m (V i) - couplingPotential m (U i)) else 0) := by rw [c3]
      _ ≤ 4 * ((a/2) * (∑ i, if 0 < V i - U i then
          w i * (|U i - m| + |V i - m|) else 0)) :=
            mul_le_mul_of_nonneg_left s5 (by norm_num)
      _ = 2 * a * (∑ i, if 0 < V i - U i then
          w i * (|U i - m| + |V i - m|) else 0) := by ring
  -- positive side: D² ≤ a·D on `0 < D ≤ a`
  have hpos : (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) ≤
      a * (∑ i, w i * max (V i - U i) 0) := by
    have h1 : (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) ≤
        (∑ i, if 0 < V i - U i then w i * (a * (V i - U i)) else 0) := by
      apply Finset.sum_le_sum
      intro i _
      by_cases h : 0 < V i - U i
      · rw [if_pos h, if_pos h]
        have hd : (V i - U i) * (V i - U i) ≤ a * (V i - U i) :=
          mul_le_mul_of_nonneg_right (hstep i) (le_of_lt h)
        nlinarith [hd, hw i]
      · rw [if_neg h, if_neg h]
    have h2 : (∑ i, if 0 < V i - U i then w i * (a * (V i - U i)) else 0) =
        a * (∑ i, if 0 < V i - U i then w i * (V i - U i) else 0) := by
      have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
          (if 0 < V i - U i then w i * (a * (V i - U i)) else 0) =
          a * (if 0 < V i - U i then w i * (V i - U i) else 0) := by
        intro i _
        by_cases h : 0 < V i - U i
        · rw [if_pos h, if_pos h]
          ring
        · rw [if_neg h, if_neg h]
          ring
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i hi => hpt i hi)
    have h3 : (∑ i, if 0 < V i - U i then w i * (V i - U i) else 0) =
        (∑ i, w i * max (V i - U i) 0) := by
      apply Finset.sum_congr rfl
      intro i _
      by_cases h : 0 < V i - U i
      · rw [if_pos h, max_eq_left (le_of_lt h)]
      · rw [if_neg h, max_eq_right (by linarith : V i - U i ≤ 0)]
        ring
    rw [h2, h3] at h1
    exact h1
  -- complement: E[A·1_{D>0}] ≤ 2b - t (A ≥ |D| pointwise on D < 0)
  have hcompA : (∑ i, if 0 < V i - U i then w i * (|U i - m| + |V i - m|) else 0) +
      (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) ≤ 2 * b := by
    have hAs := drift_sum_split_ite w U V (fun i => |U i - m| + |V i - m|)
    have hIA0nn : 0 ≤ (∑ i, if V i - U i = 0 then
        w i * (|U i - m| + |V i - m|) else 0) := by
      apply Finset.sum_nonneg
      intro i _
      by_cases h : V i - U i = 0
      · rw [if_pos h]
        exact mul_nonneg (hw i) (hAnneg i)
      · rw [if_neg h]
    have hn : (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) ≤
        (∑ i, if V i - U i < 0 then
          w i * (|U i - m| + |V i - m|) else 0) := by
      apply Finset.sum_le_sum
      intro i _
      by_cases h : V i - U i < 0
      · rw [if_pos h, if_pos h]
        have habs : |U i - V i| ≤ |U i - m| + |V i - m| := by
          have h2 := hAsub i
          rwa [abs_sub_comm (V i) (U i)] at h2
        exact mul_le_mul_of_nonneg_left
          (le_trans (le_abs_self (U i - V i)) habs) (hw i)
      · rw [if_neg h, if_neg h]
    have hb2 : ∑ i, w i * (|U i - m| + |V i - m|) = 2 * b := by
      have habs := hsame (fun t => |t - m|)
      have hsplit : ∑ i, w i * (|U i - m| + |V i - m|) =
          (∑ i, w i * |U i - m|) + (∑ i, w i * |V i - m|) := by
        simp only [mul_add, Finset.sum_add_distrib]
      rw [hsplit, ← habs, ← hbdef]
      ring
    linarith [hAs, hIA0nn, hn, hb2]
  -- assemble
  have hT : (∑ i, w i * max (V i - U i) 0) =
      (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) :=
    drift_pos_eq_neg w U V hmean
  have hX : 2 * a * (∑ i, if 0 < V i - U i then
        w i * (|U i - m| + |V i - m|) else 0) ≤
      4 * a * b - 2 * a * (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
    have hcompA' : (∑ i, if 0 < V i - U i then w i * (|U i - m| + |V i - m|) else 0) ≤
        2 * b - (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
      linarith [hcompA]
    calc 2 * a * (∑ i, if 0 < V i - U i then
          w i * (|U i - m| + |V i - m|) else 0) ≤
          2 * a * (2 * b -
            (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0)) :=
              mul_le_mul_of_nonneg_left hcompA' (by linarith)
      _ = 4 * a * b - 2 * a *
            (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by ring
  have hTeq : a * (∑ i, w i * max (V i - U i) 0) =
      a * (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by rw [hT]
  have hK1 := drift_sq_split w U V
  have hfinal : (∑ i, w i * (V i - U i)^2) ≤
      4 * a * b - a * (∑ i, w i * max (V i - U i) 0) := by
    linarith [hK1, hneg, hpos, hX, hTeq]
  linarith [hfinal]

/-- The positive part of the squared drift is at most `a·t` under a one-sided
step `V - U ≤ a`: pointwise `D² ≤ a·D` on `0 < D ≤ a`. -/
theorem pos_sq_sum_le_step {Ω : Type*} [Fintype Ω] (w U V : Ω → ℝ) (hw : ∀ i, 0 ≤ w i)
    (a : ℝ) (hstep : ∀ i, V i - U i ≤ a) :
    (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) ≤
      a * (∑ i, w i * max (V i - U i) 0) := by
  classical
  have h1 : (∑ i, if 0 < V i - U i then w i * (V i - U i)^2 else 0) ≤
      (∑ i, if 0 < V i - U i then w i * (a * (V i - U i)) else 0) := by
    apply Finset.sum_le_sum
    intro i _
    by_cases h : 0 < V i - U i
    · rw [if_pos h, if_pos h]
      have hd : (V i - U i) * (V i - U i) ≤ a * (V i - U i) :=
        mul_le_mul_of_nonneg_right (hstep i) (le_of_lt h)
      nlinarith [hd, hw i]
    · rw [if_neg h, if_neg h]
  have h2 : (∑ i, if 0 < V i - U i then w i * (a * (V i - U i)) else 0) =
      a * (∑ i, if 0 < V i - U i then w i * (V i - U i) else 0) := by
    have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
        (if 0 < V i - U i then w i * (a * (V i - U i)) else 0) =
        a * (if 0 < V i - U i then w i * (V i - U i) else 0) := by
      intro i _
      by_cases h : 0 < V i - U i
      · rw [if_pos h, if_pos h]
        ring
      · rw [if_neg h, if_neg h]
        ring
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i hi => hpt i hi)
  have h3 : (∑ i, if 0 < V i - U i then w i * (V i - U i) else 0) =
      (∑ i, w i * max (V i - U i) 0) := by
    apply Finset.sum_congr rfl
    intro i _
    by_cases h : 0 < V i - U i
    · rw [if_pos h, max_eq_left (le_of_lt h)]
    · rw [if_neg h, max_eq_right (by linarith : V i - U i ≤ 0)]
      ring
  rw [h2, h3] at h1
  exact h1

/-- The negative part of the squared drift is at most `L·t` under a one-sided
range `U - V ≤ L`: pointwise `D² ≤ L·(-D)` on `D < 0`. -/
theorem neg_sq_sum_le_range {Ω : Type*} [Fintype Ω] (w U V : Ω → ℝ) (hw : ∀ i, 0 ≤ w i)
    (L : ℝ) (hrange : ∀ i, U i - V i ≤ L) :
    (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) ≤
      L * (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
  classical
  have h1 : (∑ i, if V i - U i < 0 then w i * (V i - U i)^2 else 0) ≤
      (∑ i, if V i - U i < 0 then w i * (L * (U i - V i)) else 0) := by
    apply Finset.sum_le_sum
    intro i _
    by_cases h : V i - U i < 0
    · rw [if_pos h, if_pos h]
      have hd : (U i - V i) * (U i - V i) ≤ L * (U i - V i) :=
        mul_le_mul_of_nonneg_right (hrange i) (by linarith)
      nlinarith [hd, hw i]
    · rw [if_neg h, if_neg h]
  have h2 : (∑ i, if V i - U i < 0 then w i * (L * (U i - V i)) else 0) =
      L * (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by
    have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
        (if V i - U i < 0 then w i * (L * (U i - V i)) else 0) =
        L * (if V i - U i < 0 then w i * (U i - V i) else 0) := by
      intro i _
      by_cases h : V i - U i < 0
      · rw [if_pos h, if_pos h]
        ring
      · rw [if_neg h, if_neg h]
        ring
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i hi => hpt i hi)
  rw [h2] at h1
  exact h1

/-- **Finite-range corollary (6)** of the compensated coupling — one paragraph
of algebra from `compensated_coupling_at`: with `D⁺ ≤ a` and `D⁻ ≤ L`,
`Q := E D² ≤ (L + a)·t`, and multiplying `Q + a·t ≤ 4ab` by `L + a` and
adding `a·(Q - (L + a)t ≤ 0)` gives `(L + 2a)·Q ≤ 4ab·(L + a)`.  No
integrality, no charge mass; the paper's block instantiation is `L = n`,
`a = d`. -/
theorem compensated_coupling_finite_range {Ω : Type*} [Fintype Ω]
    (w U V : Ω → ℝ) (m a L : ℝ)
    (hw : ∀ i, 0 ≤ w i)
    (hsame : ∀ φ : ℝ → ℝ, ∑ i, w i * φ (U i) = ∑ i, w i * φ (V i))
    (ha : 0 ≤ a) (hstep : ∀ i, V i - U i ≤ a)
    (hL : 0 < L) (hrange : ∀ i, U i - V i ≤ L) :
    ∑ i, w i * (V i - U i)^2 ≤
      4 * a * (∑ i, w i * |U i - m|) * (L + a) / (L + 2 * a) := by
  classical
  have hmean : ∑ i, w i * (V i - U i) = 0 := by
    have h1 := hsame (fun t => t)
    have hsplit : ∑ i, w i * (V i - U i) =
        (∑ i, w i * V i) - (∑ i, w i * U i) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hsplit, h1, sub_self]
  have hT : (∑ i, w i * max (V i - U i) 0) =
      (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) :=
    drift_pos_eq_neg w U V hmean
  have hP2 := pos_sq_sum_le_step w U V hw a hstep
  have hN2 := neg_sq_sum_le_range w U V hw L hrange
  have hK1 := drift_sq_split w U V
  have hQ : (∑ i, w i * (V i - U i)^2) ≤ (L + a) * (∑ i, w i * max (V i - U i) 0) := by
    have eL : L * (∑ i, w i * max (V i - U i) 0) =
        L * (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := by rw [hT]
    have eT : (∑ i, w i * max (V i - U i) 0) =
        (∑ i, if V i - U i < 0 then w i * (U i - V i) else 0) := hT
    have hsplit2 : (L + a) * (∑ i, w i * max (V i - U i) 0) =
        L * (∑ i, w i * max (V i - U i) 0) +
        a * (∑ i, w i * max (V i - U i) 0) := by ring
    rw [hsplit2, eL, ← eT]
    linarith [hK1, hP2, hN2]
  have h2 := compensated_coupling_at w U V m a hw hsame ha hstep
  have hL2 : 0 < L + 2 * a := by linarith
  have m1 : (L + a) * ((∑ i, w i * (V i - U i)^2) +
      a * (∑ i, w i * max (V i - U i) 0)) ≤
      (L + a) * (4 * a * (∑ i, w i * |U i - m|)) :=
    mul_le_mul_of_nonneg_left h2 (by linarith)
  have m2 : a * ((∑ i, w i * (V i - U i)^2) -
      (L + a) * (∑ i, w i * max (V i - U i) 0)) ≤ 0 := by
    have hnn : 0 ≤ (L + a) * (∑ i, w i * max (V i - U i) 0) -
        (∑ i, w i * (V i - U i)^2) := sub_nonneg.mpr hQ
    have hEq : a * ((∑ i, w i * (V i - U i)^2) -
        (L + a) * (∑ i, w i * max (V i - U i) 0)) =
        -(a * ((L + a) * (∑ i, w i * max (V i - U i) 0) -
        (∑ i, w i * (V i - U i)^2))) := by ring
    rw [hEq]
    exact neg_nonpos.mpr (mul_nonneg ha hnn)
  have key : (∑ i, w i * (V i - U i)^2) * (L + 2 * a) ≤
      4 * a * (∑ i, w i * |U i - m|) * (L + a) := by
    nlinarith [m1, m2]
  rw [le_div_iff₀ hL2]
  exact key

end AverageSensitivity
/- End source module AverageSensitivity.RefinedCoupling. -/

/- Begin source module AverageSensitivity.ChargeMass (AverageSensitivity/ChargeMass.lean). -/
/-!
# The charge-mass bound: `p ≤ C/(C+1)`

The charged coupling (`RefinedCoupling.finite_coupling_refined_charge`)
charges the `a^2` slack only to indices whose forward step exceeds `2a/3`.
For the d=1 block instantiation (integral steps bounded by 1) those are
exactly the `V - U = 1` indices, and equal marginals pin the forward mass
to the backward mass, which the range bound caps at `C` per unit weight.
-/

open scoped BigOperators
namespace AverageSensitivity

theorem charge_mass_le {Ω : Type*} [Fintype Ω] [DecidableEq Ω]
    (w U V : Ω → ℝ) (C : ℝ)
    (hw : ∀ i, 0 ≤ w i) (hprob : ∑ i, w i = 1)
    (hsame : ∀ φ : ℝ → ℝ, ∑ i, w i * φ (U i) = ∑ i, w i * φ (V i))
    (hstep : ∀ i, w i ≠ 0 → V i - U i ≤ 1)
    (hint : ∀ i, ∃ k : ℤ, V i - U i = (k:ℝ))
    (hC : (1:ℝ) ≤ C) (hCbound : ∀ i, w i ≠ 0 → |V i - U i| ≤ C) :
    (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) ≤ C/(C+1) := by
  classical
  have hC0 : (0:ℝ) ≤ C := by linarith
  -- the drift is zero on equal marginals
  have hzero : ∑ i, w i * (V i - U i) = 0 := by
    have h1 : (∑ i, w i * U i) = (∑ i, w i * V i) := hsame (fun t => t)
    have hsplit : ∑ i, w i * (V i - U i) =
        (∑ i, w i * V i) - (∑ i, w i * U i) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hsplit, h1, sub_self]
  -- on the support: forward steps are exactly 1; quiet steps are exactly 0
  have hfwd_eq : ∀ i, w i ≠ 0 → 2/(3:ℝ) < V i - U i → V i - U i = 1 := by
    intro i hw0 h
    obtain ⟨k, hk⟩ := hint i
    rw [hk] at h
    have hk1 : (1:ℤ) ≤ k := by
      by_contra hcon
      push_neg at hcon
      have hk0 : k ≤ 0 := by omega
      have hle : (k:ℝ) ≤ 0 := Int.cast_nonpos.mpr hk0
      linarith
    have hk2 : k ≤ 1 := by
      by_contra hcon
      push_neg at hcon
      have h2 : (2:ℝ) ≤ (k:ℝ) := by exact_mod_cast hcon
      have := hstep i hw0
      rw [hk] at this
      linarith
    have : (k:ℝ) = 1 := by exact_mod_cast (by omega : k = 1)
    rw [hk, this]
  have hquiet_eq : ∀ i, w i ≠ 0 → ¬(2/(3:ℝ) < V i - U i) → ¬(V i - U i ≤ -1) →
      V i - U i = 0 := by
    intro i hw0 hf hb
    obtain ⟨k, hk⟩ := hint i
    have hk0 : k = 0 := by
      by_contra hcon
      rcases lt_or_ge k 0 with hlt | hge
      · have hc2 : k ≤ -1 := by omega
        have hrm : (k:ℝ) ≤ -1 := by exact_mod_cast hc2
        apply hb
        rw [hk]
        exact hrm
      · have hk1 : (1:ℤ) ≤ k := by omega
        have h1 : (1:ℝ) ≤ (k:ℝ) := by exact_mod_cast hk1
        apply hf
        rw [hk]
        linarith
    rw [hk, hk0]
    norm_num
  -- decompose the drift into the forward, middle, and backward classes
  -- (the three conditions partition ℝ: > 2/3, ≤ -1, or the middle)
  have hdecomp : ∀ i, w i * (V i - U i) =
      (if 2/(3:ℝ) < V i - U i then w i * (V i - U i) else 0) +
      (if V i - U i ≤ -1 then w i * (V i - U i) else 0) +
      (if ¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1) then w i * (V i - U i) else 0) := by
    intro i
    by_cases h1 : 2/(3:ℝ) < V i - U i
    · have hnot2 : ¬(V i - U i ≤ -1) := by intro h2; linarith
      have hnot3 : ¬(¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1)) := fun hc => hc.1 h1
      rw [if_pos h1, if_neg hnot2, if_neg hnot3]
      ring
    · rw [if_neg h1]
      by_cases h2 : V i - U i ≤ -1
      · have hnot3 : ¬(¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1)) := fun hc => hc.2 h2
        rw [if_pos h2, if_neg hnot3]
        ring
      · rw [if_neg h2, if_pos ⟨h1, h2⟩]
        ring
  have hsum_decomp : ∑ i, w i * (V i - U i) =
      (∑ i, if 2/(3:ℝ) < V i - U i then w i * (V i - U i) else 0) +
      (∑ i, if V i - U i ≤ -1 then w i * (V i - U i) else 0) +
      (∑ i, if ¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1) then w i * (V i - U i) else 0) := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i _ => hdecomp i)
  -- the middle class contributes nothing
  have hquiet_sum : (∑ i, if ¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1) then w i * (V i - U i) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    by_cases hcls : ¬(2/(3:ℝ) < V i - U i) ∧ ¬(V i - U i ≤ -1)
    · rw [if_pos hcls]
      by_cases hw0 : w i = 0
      · simp [hw0]
      · rw [hquiet_eq i hw0 hcls.1 hcls.2]
        ring
    · rw [if_neg hcls]
  -- the forward class carries exactly its weight
  have hfwd_sum : (∑ i, if 2/(3:ℝ) < V i - U i then w i * (V i - U i) else 0) =
      (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) := by
    apply Finset.sum_congr rfl
    intro i _
    by_cases h1 : 2/(3:ℝ) < V i - U i
    · rw [if_pos h1, if_pos h1]
      by_cases hw0 : w i = 0
      · simp [hw0]
      · rw [hfwd_eq i hw0 h1]
        ring
    · rw [if_neg h1, if_neg h1]
  -- so p equals the backward mass
  have hsplit0 : (∑ i, if 2/(3:ℝ) < V i - U i then w i * (V i - U i) else 0) +
      (∑ i, if V i - U i ≤ -1 then w i * (V i - U i) else 0) = 0 := by
    have h3 := hsum_decomp
    have hq := hquiet_sum
    linarith [h3, hq]
  have h4 : (∑ i, if V i - U i ≤ -1 then w i * (V i - U i) else 0) =
      -((∑ i, if V i - U i ≤ -1 then w i * (U i - V i) else 0)) := by
    have hpt : ∀ i : Ω, (if V i - U i ≤ -1 then w i * (V i - U i) else 0) =
        (-(if V i - U i ≤ -1 then w i * (U i - V i) else 0)) := by
      intro i
      by_cases h : V i - U i ≤ -1
      · rw [if_pos h, if_pos h]
        ring
      · rw [if_neg h, if_neg h]
        ring
    calc (∑ i, if V i - U i ≤ -1 then w i * (V i - U i) else 0)
        = (∑ i, (-(if V i - U i ≤ -1 then w i * (U i - V i) else 0))) :=
          Finset.sum_congr rfl (fun i _ => hpt i)
      _ = -((∑ i, if V i - U i ≤ -1 then w i * (U i - V i) else 0)) := by
          simp
  have hp_eq : (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) =
      (∑ i, if V i - U i ≤ -1 then w i * (U i - V i) else 0) := by
    have hf := hfwd_sum
    linarith [hsplit0, h4, hf]
  -- the backward mass is at most C times the backward weight
  have hbwd_le : (∑ i, if V i - U i ≤ -1 then w i * (U i - V i) else 0) ≤
      C*(∑ i, if V i - U i ≤ -1 then w i else 0) := by
    have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
        (if V i - U i ≤ -1 then w i * (U i - V i) else 0) ≤
        C*(if V i - U i ≤ -1 then w i else 0) := by
      intro i _
      by_cases h1 : V i - U i ≤ -1
      · rw [if_pos h1, if_pos h1]
        by_cases hw0 : w i = 0
        · simp [hw0]
        · have := hCbound i hw0
          rw [abs_le] at this
          nlinarith [this, hw i, mul_nonneg (hw i) hC0]
      · rw [if_neg h1, if_neg h1]
        exact mul_nonneg hC0 (by simp)
    calc (∑ i, if V i - U i ≤ -1 then w i * (U i - V i) else 0) ≤
          ∑ i, C*(if V i - U i ≤ -1 then w i else 0) :=
        Finset.sum_le_sum hpt
      _ = C*(∑ i, if V i - U i ≤ -1 then w i else 0) := by
        rw [Finset.mul_sum]
  -- forward and backward weights are disjoint parts of the whole
  have hpq : (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) +
      (∑ i, if V i - U i ≤ -1 then w i else 0) ≤ 1 := by
    have hpt : ∀ i ∈ (Finset.univ : Finset Ω),
        (if 2/(3:ℝ) < V i - U i then w i else 0) +
        (if V i - U i ≤ -1 then w i else 0) ≤ w i := by
      intro i _
      by_cases h1 : 2/(3:ℝ) < V i - U i
      · rw [if_pos h1]
        have hnot2 : ¬(V i - U i ≤ -1) := by intro h2; linarith
        rw [if_neg hnot2]
        linarith [hw i]
      · rw [if_neg h1]
        by_cases h2 : V i - U i ≤ -1
        · rw [if_pos h2]; linarith [hw i]
        · rw [if_neg h2]; linarith [hw i]
    calc (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) +
          (∑ i, if V i - U i ≤ -1 then w i else 0)
        = ∑ i, ((if 2/(3:ℝ) < V i - U i then w i else 0) +
            (if V i - U i ≤ -1 then w i else 0)) := Finset.sum_add_distrib.symm
      _ ≤ ∑ i, w i := Finset.sum_le_sum hpt
      _ = 1 := hprob
  -- combine: p ≤ C·q and p + q ≤ 1 give p ≤ C/(C+1)
  have hp : (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0) ≤
      C*(∑ i, if V i - U i ≤ -1 then w i else 0) := by
    rw [hp_eq]
    exact hbwd_le
  have hfinal : (∑ i, if 2/(3:ℝ) < V i - U i then w i else 0)*(1+C) ≤ C := by
    nlinarith [hp, hpq, hC]
  have hpos : (0:ℝ) < 1+C := by linarith
  rw [show C/(C+1) = C/(1+C) from by ring]
  exact (le_div_iff₀ hpos).mpr hfinal

end AverageSensitivity
/- End source module AverageSensitivity.ChargeMass. -/

/- Begin source module AverageSensitivity.BinomialMAD (AverageSensitivity/BinomialMAD.lean). -/
open scoped BigOperators
namespace AverageSensitivity

noncomputable def rawMAD (n : ℕ) : ℝ :=
  ∑ j ∈ Finset.range (n+1), (n.choose j : ℝ)*|2*(j:ℝ)-(n:ℝ)|

theorem abs_walk_step (n j : ℕ) :
    |2*(j:ℝ)-(n:ℝ)-1|+|2*(j:ℝ)-(n:ℝ)+1| =
      2*|2*(j:ℝ)-(n:ℝ)| + if 2*j=n then 2 else 0 := by
  split_ifs with h
  · have he : 2*(j:ℝ)=(n:ℝ) := by exact_mod_cast h
    norm_num [he]
  · by_cases hlt : 2*j<n
    · have hr : 2*(j:ℝ)+1 ≤ (n:ℝ) := by exact_mod_cast hlt
      rw [abs_of_nonpos (by linarith),abs_of_nonpos (by linarith),abs_of_nonpos (by linarith)]
      ring
    · have hgt : n+1≤2*j := by omega
      have hr : (n:ℝ)+1≤2*(j:ℝ) := by exact_mod_cast hgt
      rw [abs_of_nonneg (by linarith),abs_of_nonneg (by linarith),abs_of_nonneg (by linarith)]
      ring

theorem rawMAD_succ (n : ℕ) :
    rawMAD (n+1) = 2*rawMAD n +
      ∑ j ∈ Finset.range (n+1), (n.choose j : ℝ)*(if 2*j=n then 2 else 0) := by
  unfold rawMAD
  rw [Finset.sum_choose_succ_mul (fun j _ => |2*(j:ℝ)-((n+1:ℕ):ℝ)|) n]
  rw [← Finset.sum_add_distrib]
  calc
    _ = ∑ j ∈ Finset.range (n+1), (n.choose j : ℝ)*
        (2*|2*(j:ℝ)-(n:ℝ)|+(if 2*j=n then 2 else 0)) := by
      apply Finset.sum_congr rfl
      intro j _
      push_cast
      have h := abs_walk_step n j
      have he : 2*((j:ℝ)+1)-((n:ℝ)+1)=2*(j:ℝ)-(n:ℝ)+1 := by ring
      rw [he]
      rw [show 2*(j:ℝ)-((n:ℝ)+1)=2*(j:ℝ)-(n:ℝ)-1 by ring]
      rw [← mul_add, h]
    _ = _ := by
      simp only [mul_add,Finset.sum_add_distrib,Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intros
      ring

theorem rawMAD_succ_even (k : ℕ) :
    rawMAD (2*k+1) = 2*rawMAD (2*k)+2*((2*k).choose k : ℝ) := by
  rw [rawMAD_succ]
  congr 1
  rw [Finset.sum_eq_single k]
  · simp
    ring
  · intro j _ hj
    have h : ¬2*j=2*k := by omega
    simp [h]
  · simp
    omega

theorem rawMAD_succ_odd (k : ℕ) :
    rawMAD (2*k+2) = 2*rawMAD (2*k+1) := by
  have h := rawMAD_succ (2*k+1)
  have hz : (∑ j ∈ Finset.range (2*k+1+1), ((2*k+1).choose j : ℝ)*
      (if 2*j=2*k+1 then 2 else 0))=0 := by
    apply Finset.sum_eq_zero
    intro j _
    have he : ¬2*j=2*k+1 := by omega
    simp [he]
  simpa only [hz,add_zero] using h

theorem rawMAD_even (k : ℕ) :
    rawMAD (2*k) = 2*(k:ℝ)*(Nat.centralBinom k : ℝ) := by
  induction k with
  | zero => norm_num [rawMAD, Nat.centralBinom]
  | succ k ih =>
    have he := rawMAD_succ_even k
    have ho := rawMAD_succ_odd k
    have hc : ((k:ℝ)+1)*(Nat.centralBinom (k+1):ℝ) =
        2*(2*(k:ℝ)+1)*(Nat.centralBinom k:ℝ) := by
      exact_mod_cast Nat.succ_mul_centralBinom_succ k
    rw [show 2*(k+1)=2*k+2 by omega,ho,he,ih]
    simp only [Nat.cast_add,Nat.cast_one,Nat.centralBinom] at *
    nlinarith

theorem rawMAD_odd (k : ℕ) :
    rawMAD (2*k+1) = 2*(2*(k:ℝ)+1)*(Nat.centralBinom k : ℝ) := by
  rw [rawMAD_succ_even,rawMAD_even]
  simp only [Nat.centralBinom]
  ring

noncomputable def central (k : ℕ) : ℝ := (Nat.centralBinom k:ℝ)/(4:ℝ)^k
noncomputable def mad (n : ℕ) : ℝ := rawMAD n/(2*(2:ℝ)^n)

theorem mad_even (k : ℕ) : mad (2*k) = (k:ℝ)*central k := by
  simp only [mad,rawMAD_even,central,pow_mul]
  norm_num
  ring

theorem mad_odd (k : ℕ) : mad (2*k+1) = (2*(k:ℝ)+1)*central k/2 := by
  simp only [mad,rawMAD_odd,central,pow_add,pow_mul]
  norm_num
  ring

theorem mad_zero : mad 0 = 0 := by
  simp [mad, rawMAD]

theorem mad_nonneg (n : ℕ) : 0 ≤ mad n := by
  unfold mad rawMAD
  refine div_nonneg (Finset.sum_nonneg fun j _ => ?_) (by positivity)
  exact mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _)

theorem central_step (k : ℕ) :
    (2*(k:ℝ)+2)*central (k+1) = (2*(k:ℝ)+1)*central k := by
  have hc : ((k:ℝ)+1)*(Nat.centralBinom (k+1):ℝ) =
        2*(2*(k:ℝ)+1)*(Nat.centralBinom k:ℝ) := by
    exact_mod_cast Nat.succ_mul_centralBinom_succ k
  unfold central
  rw [pow_succ]
  field_simp
  nlinarith

end AverageSensitivity
