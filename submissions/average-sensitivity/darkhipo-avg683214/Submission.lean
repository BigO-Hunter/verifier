namespace Race

theorem bound : BigOSpeedrun.AverageSensitivity.Bound (683/214 : ℚ) := by
  intro n d hn hd _ p hdegree
  convert _root_.AverageSensitivity.AS_bound_683_214 hn hd p hdegree using 1 <;>
    norm_num

end Race

